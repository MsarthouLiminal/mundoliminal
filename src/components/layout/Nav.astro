---
const links = [
  { href: '/senales', label: 'Señales' },
  { href: '/sobre-martin', label: 'Martín Sarthou' },
  { href: '/talks', label: 'Talks' },
  { href: '/reportes', label: 'Reportes' },
  { href: '/consultoria', label: 'Consultoría' },
  { href: '/eventos', label: 'Agenda' },
  { href: '/catalogo', label: 'Catálogo' },
  { href: '/transparencia', label: 'Transparencia' },
  { href: '/contacto', label: 'Contacto' },
];

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<nav class="nav" aria-label="Navegación principal">
  <ul>
    {links.map(({ href, label }) => {
      const active = current === href || current.startsWith(href + '/');
      return (
        <li>
          <a href={href + '/'} aria-current={active ? 'page' : undefined} class:list={[{ active }]}>
            {label}
          </a>
        </li>
      );
    })}
  </ul>
</nav>

<style>
  .nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    font-family: var(--font-text-v2);
    font-weight: 500;
    font-size: 0.9rem;
    line-height: 1.3;
  }
  .nav a {
    text-decoration: none;
    color: var(--tinta);
    border-bottom: 1px solid transparent;
    padding-bottom: 2px;
    transition: border-color 150ms, color 150ms;
  }
  .nav a:hover,
  .nav a.active {
    border-bottom-color: var(--acento);
    color: var(--acento);
  }
</style>
