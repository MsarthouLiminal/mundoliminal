---
import SocialIcons from './SocialIcons.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <p class="tagline">Contexto, mecanismo, consecuencia</p>
  <SocialIcons />
  <a class="email" href="mailto:contacto@mundoliminal.com">contacto@mundoliminal.com</a>
  <p class="meta">© {year} LIMINAL</p>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-24);
    padding: var(--space-12) var(--space-8) var(--space-8);
    border-top: 1px solid var(--rule);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    align-items: center;
    text-align: center;
    font-family: var(--font-text-v2);
  }
  .tagline {
    font-weight: 500;
    font-size: 1rem;
    color: var(--tinta-meta);
  }
  .email {
    font-size: 0.9rem;
    color: var(--tinta-suave);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 150ms, border-color 150ms;
  }
  .email:hover {
    color: var(--acento);
    border-bottom-color: var(--acento);
  }
  .meta {
    font-size: 0.8rem;
    color: var(--tinta-suave);
  }

  @media (max-width: 720px) {
    .site-footer {
      padding: var(--space-8) var(--space-4);
      gap: var(--space-4);
    }
  }
</style>
