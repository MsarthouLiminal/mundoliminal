---
/**
 * BigBoard: el tablero de Señales.
 *
 * Mapa del mundo en puntos, inclinado, con un haz de luz por señal (altura =
 * intensidad, color = tendencia). Al tocar una señal la cámara se acerca, se
 * abre la ficha con el hecho, la lectura y la fuente, y una vista cartográfica
 * de cerca del lugar. Todo sale del JSON de la edición: cuando se publica una
 * actualización, el tablero cambia solo.
 *
 * Tres modos:
 *  - pagina:  /senales, a todo el ancho, con lista, ficha y acercamiento.
 *  - sala:    /senales/sala, pantalla completa para proyectar.
 *  - portada: la home, compacto; cada número lleva a su señal en /senales.
 */
import {
  type Edicion,
  semanaDel,
  fechaSinAnio,
  fechaHora,
  ultimaActualizacion,
} from '../../lib/senales';
import { VW, VH, ZOOM, geometriaBoard, senalesBoard, senalInicial } from '../../lib/big-board';

interface Props {
  edicion: Edicion;
  modo?: 'pagina' | 'sala' | 'portada';
}

const { edicion, modo = 'pagina' } = Astro.props;

const geo = geometriaBoard(edicion);
const senales = senalesBoard(edicion);
const puntoDe = (n: number) => geo.puntos.find((p) => p.n === n)!;
const inicial = senales.find((s) => s.n === senalInicial(edicion)) ?? senales[0];
const pIni = puntoDe(inicial.n);
const actualizada = ultimaActualizacion(edicion);
const total = senales.length;
const enEscalada = senales.filter((s) => s.tendencia === 'escala').length;
const conFicha = modo !== 'portada';
const id = `bb-${modo}`;

const pad = (n: number) => String(n).padStart(2, '0');
const pct = (v: number, d: number) => `${((v / d) * 100).toFixed(2)}%`;
const TEND: Record<string, string> = { escala: 'Escala', estable: 'Se sostiene', afloja: 'Afloja' };
const SIMB: Record<string, string> = { escala: '▲', estable: '■', afloja: '▼' };
const EJE_COD: Record<string, string> = { min: 'EJE MIN', cho: 'EJE CHK', ia: 'EJE IA', con: 'EJE CON' };
const MODO_VISTA: Record<string, string> = { min: 'GEO', cho: 'EO', ia: 'IR', con: 'SAR' };

const ejes = edicion.ejes.map((eje) => {
  const propias = senales.filter((s) => s.eje === eje.id);
  return { id: eje.id, nombre: eje.nombre, senales: propias, alta: propias.some((s) => s.intensidad === 3) };
});

const RELOJES: [string, string][] = [
  ['Washington', 'America/New_York'],
  ['Bruselas', 'Europe/Brussels'],
  ['Moscú', 'Europe/Moscow'],
  ['Teherán', 'Asia/Tehran'],
  ['Beijing', 'Asia/Shanghai'],
  ['Montevideo', 'America/Montevideo'],
];

// La cinta de abajo: lo que viene en la agenda y los focos en observación.
const hoy = new Date().toISOString().slice(0, 10);
const proximas = edicion.agenda.filter((a) => !a.fecha || a.fecha >= hoy).map((a) => `${a.texto}: ${a.detalle}`);
const ejeFocos = edicion.ejes.find((e) => e.id === 'con');
const focosTexto = ejeFocos?.tambien.length
  ? ejeFocos.tambien.map((t) => `${t.etiqueta}: ${t.texto}`)
  : edicion.focos.map((f) => f.nombre);
const cinta = [
  ...(proximas.length ? ['Qué observar', ...proximas] : []),
  'Focos en observación',
  ...focosTexto,
].join('  /  ');

const ini = inicial;
const avisoUm = ini.umHasta !== null && Date.now() < ini.umHasta;
const avisoTexto = avisoUm
  ? `Último momento, ${ini.actualizado ?? ini.fecha}`
  : ini.actualizado
    ? `Actualizado el ${ini.actualizado}`
    : '';

const datos = {
  edicion: edicion.id,
  zoom: ZOOM,
  inicial: ini.n,
  focos: edicion.focos.length,
  acercamientos: `/senales/acercamientos/${edicion.id}.json`,
  senales: senales.map((s) => ({ ...s, p: puntoDe(s.n) })),
};
const json = JSON.stringify(datos).replace(/</g, '\\u003c');
---

<section class:list={['bb', `bb--${modo}`]} data-bigboard data-modo={modo} aria-labelledby={`${id}-h`}>
  <div class="bb__in">
    <header class="bb-barra">
      <div class="bb-marca">
        <p class="bb-kicker">Señales<span aria-hidden="true"> / </span>Big board</p>
        <h2 id={`${id}-h`} class="bb-titulo">Semana {edicion.semana}</h2>
        <p class="bb-fecha">
          {semanaDel(edicion.fechaEdicion)}. Datos al {fechaSinAnio(edicion.corteDatos)}.
          {actualizada && <strong> Actualizada el {fechaHora(actualizada)}.</strong>}
        </p>
      </div>
      {modo !== 'portada' && (
        <ul class="bb-relojes" aria-label="Hora en seis capitales">
          {RELOJES.map(([ciudad, zona]) => (
            <li><span>{ciudad}</span><b data-reloj={zona}>--:--</b></li>
          ))}
        </ul>
      )}
      <div class="bb-estado">
        <p class="bb-enlace"><i class="bb-led bb-led--vivo" aria-hidden="true"></i>Enlace activo</p>
        {modo === 'sala' && <button type="button" class="bb-boton" data-accion="pantalla">Pantalla completa</button>}
        {modo === 'portada' && <a class="bb-boton" href="/senales/">Abrir el monitor</a>}
      </div>
    </header>

    <div class="bb-cuerpo">
      {conFicha && (
        <nav class="bb-lista" aria-label="Señales de la semana por eje">
          <p class="bb-cifra"><b>{enEscalada}/{total}</b><span>señales<br />en escalada</span></p>
          <p class="bb-ayuda">Tocá una señal para leerla. También podés tocar su número en el mapa.</p>
          {ejes.map((eje) => (
            <div class="bb-eje">
              <p class="bb-eje__cab">
                <i class:list={['bb-led', { 'bb-led--alta': eje.alta }]} aria-hidden="true"></i>
                {eje.nombre}
                <span>{eje.senales.length}</span>
              </p>
              <ul>
                {eje.senales.map((s) => (
                  <li>
                    <button type="button" class="bb-fila" data-fila={s.n} aria-pressed={s.n === ini.n ? 'true' : 'false'}>
                      <span class="bb-num" data-t={s.tendencia}>{pad(s.n)}</span>
                      <span class="bb-fila__lugar">{s.lugar}</span>
                      <span class="bb-fila__t" data-t={s.tendencia}>{SIMB[s.tendencia]} {s.intensidadNombre}</span>
                    </button>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      )}

      <div class="bb-escenario">
        <div class="bb-controles">
          <p class="bb-rotulo" data-rotulo data-base={`Teatro global / ${total} señales / ${edicion.focos.length} focos`}>
            Teatro global / {total} señales / {edicion.focos.length} focos
          </p>
          <div class="bb-botones">
            <button type="button" class="bb-boton" data-accion="global">Teatro global</button>
            <button type="button" class="bb-boton bb-boton--rec" data-accion="recorrido" aria-pressed="true">Recorrido</button>
          </div>
        </div>
        <div class="bb-escena">
          <svg class="bb-svg" viewBox={`0 0 ${VW} ${VH}`} aria-hidden="true" focusable="false">
            <defs>
              <filter id={`${id}-brillo`} x="-50%" y="-50%" width="200%" height="200%">
                <feGaussianBlur stdDeviation="3" />
              </filter>
            </defs>
            <g class="bb-camara" data-camara>
              <path class="bb-grilla" d={geo.grilla} />
              <path class="bb-tierra" d={geo.tierra} />
              <path class="bb-focos" d={geo.focos} />
              <path class="bb-arcos" d={geo.arcos} />
              <path class="bb-haz bb-haz--estable" d={geo.haces.estable} />
              <path class="bb-haz bb-haz--afloja" d={geo.haces.afloja} />
              <path class="bb-haz bb-haz--escala" d={geo.haces.escala} />
              <path class="bb-haz bb-haz--alta" d={geo.haces.alta} />
              <path class="bb-brillo" d={geo.brillo} filter={`url(#${id}-brillo)`} />
              <path class="bb-nucleo bb-nucleo--estable" d={geo.nucleos.estable} />
              <path class="bb-nucleo bb-nucleo--afloja" d={geo.nucleos.afloja} />
              <path class="bb-nucleo bb-nucleo--escala" d={geo.nucleos.escala} />
              <path class="bb-sel" data-sel-haz d={`M${pIni.base[0]} ${pIni.base[1]}L${pIni.tope[0]} ${pIni.tope[1]}`} />
            </g>
          </svg>
          <div class="bb-capa" data-capa>
            {senales.filter((s) => s.intensidad === 3).map((s) => {
              const p = puntoDe(s.n);
              return <span class="bb-anillo" data-t={s.tendencia} style={`left:${pct(p.base[0], VW)};top:${pct(p.base[1], VH)}`}><i></i></span>;
            })}
            <span class="bb-anillo bb-anillo--sel" data-anillo-sel style={`left:${pct(pIni.base[0], VW)};top:${pct(pIni.base[1], VH)}`}><i></i></span>
            {senales.map((s) => {
              const p = puntoDe(s.n);
              const etiqueta = s.n === ini.n ? `${pad(s.n)} ${s.corto}` : pad(s.n);
              return (
                <span class="bb-tag-pos" style={`left:${pct(p.tope[0], VW)};top:${pct(p.tope[1], VH)};--dx:${(p.dx / 10).toFixed(1)}cqw`}>
                  {modo === 'portada' ? (
                    <a class="bb-tag" href={`/senales/#senal-${s.n}`} data-tag={s.n} data-t={s.tendencia} aria-current={s.n === ini.n ? 'true' : undefined} aria-label={`Señal ${s.n}: ${s.titulo}`}>{etiqueta}</a>
                  ) : (
                    <button type="button" class="bb-tag" data-tag={s.n} data-t={s.tendencia} aria-current={s.n === ini.n ? 'true' : undefined} aria-label={`Leer la señal ${s.n}: ${s.titulo}`}>{etiqueta}</button>
                  )}
                </span>
              );
            })}
          </div>
        </div>
        <ul class="bb-leyenda" aria-hidden="true">
          <li><i data-t="escala"></i>Escala</li>
          <li><i data-t="afloja"></i>Afloja</li>
          <li><i data-t="estable"></i>Se sostiene</li>
          <li><i class="bb-leyenda__foco"></i>Foco en observación</li>
          <li class="bb-leyenda__nota">Altura del haz: intensidad</li>
        </ul>
        {modo === 'portada' && (
          <a class="bb-titular" data-titular href={`/senales/#senal-${ini.n}`}>
            <span class="bb-titular__num" data-titular-num>{pad(ini.n)}</span>
            <span class="bb-titular__t" data-titular-t>{ini.titulo}</span>
          </a>
        )}
      </div>

      {conFicha && (
        <div class="bb-cubierta">
          <div class="bb-recon" data-recon>
            <div class="bb-recon__mapa" data-recon-mapa>
              <svg viewBox="0 0 400 400" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
                <defs>
                  <pattern id={`${id}-punteado`} width="3" height="3" patternUnits="userSpaceOnUse">
                    <rect width="3" height="3" fill="#121713" />
                    <circle cx="1" cy="1" r="0.55" fill="#6d756d" />
                  </pattern>
                </defs>
                <path class="r-grilla" data-r="grilla" d="" />
                <path class="r-tierra" data-r="tierra" d="" fill={`url(#${id}-punteado)`} />
                <path class="r-fronteras" data-r="fronteras" d="" />
                <path class="r-estados" data-r="estados" d="" />
              </svg>
            </div>
            <div class="bb-recon__barrido" aria-hidden="true"></div>
            <div class="bb-reticula" data-reticula data-eje={ini.eje} aria-hidden="true">
              <div class="bb-reticula__in" data-reticula-in>
                <span class="ret ret--cho"><i></i><i></i><i></i><i></i></span>
                <span class="ret ret--ia"><i></i></span>
                <span class="ret ret--con"><i></i><i></i></span>
                <span class="ret ret--min"><i></i></span>
                <span class="ret-esquinas"><i></i><i></i><i></i><i></i></span>
                <span class="ret-bloqueo">Bloqueo</span>
              </div>
            </div>
            <span class="bb-recon__flecha" data-flecha hidden aria-hidden="true">▲</span>
            <p class="bb-hud bb-hud--ai"><span data-hud-fecha>--</span><span>UTC-3 / modo <b data-hud-modo>{MODO_VISTA[ini.eje]}</b></span></p>
            <p class="bb-hud bb-hud--ad"><span class="bb-hud__eje" data-hud-eje>{EJE_COD[ini.eje]}</span></p>
            <p class="bb-hud bb-hud--bi"><span class="bb-escala" aria-hidden="true"><i></i>100 km</span></p>
            <p class="bb-hud bb-hud--bd">Vista cartográfica, no imagen satelital</p>
          </div>
          <div class="bb-telemetria">
            <div class="bb-flaps" data-flaps="1" aria-hidden="true"></div>
            <div class="bb-flaps" data-flaps="2" aria-hidden="true"></div>
            <dl class="bb-datos">
              <div><dt>Coordenadas</dt><dd data-t-campo="coord">{ini.lat}  {ini.lon}</dd></div>
              <div><dt>Objetivo</dt><dd data-t-campo="objetivo">{ini.objetivo}</dd></div>
              <div><dt>Dato</dt><dd data-t-campo="dato">{ini.dato ?? 'Sin dato clave'}</dd></div>
              <div><dt>Enlace</dt><dd data-t-campo="enlace">{ini.arco ? `${ini.arco.nombre} / rumbo ${String(ini.arco.rumbo).padStart(3, '0')}° / ${ini.arco.km.toLocaleString('es-UY')} km` : 'Sin enlace'}</dd></div>
              <div>
                <dt>Intensidad</dt>
                <dd>
                  <span class="bb-lamparas" data-t-campo="lamparas" data-t={ini.tendencia} data-i={ini.intensidad}><i></i><i></i><i></i></span>
                  <span data-t-campo="intensidad">{ini.intensidadNombre}</span>
                </dd>
              </div>
            </dl>
          </div>
        </div>
      )}

      {conFicha && (
        <article class="bb-ficha" data-ficha aria-live="polite">
          <p class="bb-ficha__cab">
            <span data-f="cab">Señal {pad(ini.n)} / {ini.ejeNombre}</span>
            <span class:list={['bb-aviso', { 'bb-aviso--um': avisoUm }]} data-f="aviso" hidden={!avisoTexto}>{avisoTexto}</span>
          </p>
          <h3 class="bb-ficha__titulo" data-f="titulo">{ini.titulo}</h3>
          <p class="bb-ficha__chips">
            <span data-f="lugar">{ini.lugar}</span>
            <span data-f="fecha">{ini.fecha}</span>
            <span class="bb-chip-t" data-f="tendencia" data-t={ini.tendencia}>{SIMB[ini.tendencia]} {TEND[ini.tendencia]} / intensidad {ini.intensidadNombre.toLowerCase()}</span>
          </p>
          <p class="bb-ficha__rot">El hecho</p>
          <p class="bb-ficha__hecho" data-f="hecho">{ini.hecho}</p>
          <hr class="bb-umbral" />
          <p class="bb-ficha__rot bb-ficha__rot--senal">La lectura</p>
          <p class="bb-ficha__lectura" data-f="lectura">{ini.lectura}</p>
          <p class="bb-ficha__fuente">
            <span>Fuente</span>
            <a data-f="fuente" href={ini.fuente.url} target="_blank" rel="noopener">{ini.fuente.nombre}, {ini.fecha}</a>
          </p>
          <a class="bb-ficha__analisis" data-f="analisis" href={ini.analisis?.url ?? '#'} target="_blank" rel="noopener" hidden={!ini.analisis}>
            Análisis LIMINAL: <span data-f="analisis-t">{ini.analisis?.titulo ?? ''}</span>
          </a>
          <a class="bb-ficha__mas" data-f="mas" href={`${modo === 'sala' ? '/senales/' : ''}#senal-${ini.n}`}>
            <span data-f="mas-t">{ini.tieneAnterior ? 'Ver la señal en la lista, con la versión del lunes' : 'Ver la señal en la lista'}</span>
          </a>
        </article>
      )}
    </div>

    {modo !== 'portada' && (
      <div class="bb-cinta" aria-label="Agenda y focos en observación">
        <div class="bb-cinta__in"><span>{cinta}  /  </span><span aria-hidden="true">{cinta}  /  </span></div>
      </div>
    )}
  </div>
  <script is:inline type="application/json" data-bigboard-datos set:html={json}></script>
</section>

<script>
  import '../../scripts/big-board.ts';
</script>

<style is:global>
  html:has(.bb--pagina) { overflow-x: clip; }

  .bb {
    --bb-vacio: var(--color-vacio, #060c08);
    --bb-selva: var(--color-selva, #0b2419);
    --bb-bosque: var(--color-bosque, #1a3d2b);
    --bb-sal: var(--color-sal, #e8eae3);
    --bb-hueso: var(--color-hueso, #ded8ce);
    --bb-horizonte: var(--color-horizonte, #ff7a1a);
    --bb-lila: var(--color-lila, #c6b8db);
    --bb-teal: var(--color-teal, #0b8b6e);
    --bb-teal-b: var(--color-teal-brillante, #0fba94);
    --bb-texto: var(--font-text-v2, 'Chivo', 'Helvetica Neue', Arial, sans-serif);
    --bb-display: var(--font-display-v2, 'Big Shoulders Display', 'Arial Narrow', sans-serif);
    --z: 1;
    background: var(--bb-vacio);
    color: var(--bb-sal);
    font-family: var(--bb-texto);
    color-scheme: dark;
  }
  .bb *, .bb *::before, .bb *::after { box-sizing: border-box; }
  .bb p, .bb ul, .bb dl, .bb dd, .bb h2, .bb h3 { margin: 0; }
  .bb ul { list-style: none; padding: 0; }
  .bb [hidden] { display: none !important; }
  .bb [data-t="escala"] { --t: var(--bb-horizonte); }
  .bb [data-t="afloja"] { --t: var(--bb-teal-b); }
  .bb [data-t="estable"] { --t: var(--bb-lila); }

  .bb--pagina {
    width: 100vw;
    margin: 0 calc(50% - 50vw) var(--space-12, 3rem);
  }
  .bb--sala { min-height: 100vh; }
  .bb--portada { border-radius: 2px; }
  .bb__in { max-width: 1680px; margin: 0 auto; padding: 18px 20px 20px; display: flex; flex-direction: column; gap: 16px; }
  .bb--portada .bb__in { padding: 14px; gap: 10px; }

  /* Barra superior */
  .bb-barra { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 28px; border-bottom: 1px solid var(--bb-bosque); padding-bottom: 14px; }
  .bb-kicker { font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--bb-lila); }
  .bb-titulo { font-family: var(--bb-display); font-weight: 800; font-size: clamp(1.9rem, 3vw, 2.6rem); line-height: 0.95; text-transform: uppercase; letter-spacing: 0.01em; color: var(--bb-sal); }
  .bb-fecha { font-size: 0.8rem; color: var(--bb-lila); margin-top: 4px; }
  .bb-fecha strong { color: var(--bb-sal); font-weight: 500; }
  .bb-relojes { display: flex; flex-wrap: wrap; gap: 6px 20px; }
  .bb-relojes li { display: flex; flex-direction: column; gap: 1px; }
  .bb-relojes span { font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--bb-lila); }
  .bb-relojes b { font-size: 1.15rem; font-weight: 500; font-variant-numeric: tabular-nums; }
  .bb-estado { display: flex; align-items: center; gap: 12px; }
  .bb-enlace { display: flex; align-items: center; gap: 7px; font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; }
  .bb-led { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--bb-teal-b); flex: none; }
  .bb-led--vivo, .bb-led--alta { background: var(--bb-horizonte); animation: bb-titila 1.1s steps(2, start) infinite; }

  .bb-boton { font-family: var(--bb-texto); font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; padding: 8px 12px; min-height: 36px; background: transparent; color: var(--bb-lila); border: 1px solid var(--bb-bosque); cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; }
  .bb-boton:hover { color: var(--bb-sal); border-color: var(--bb-sal); }
  .bb-boton--rec[aria-pressed="true"] { background: var(--bb-selva); color: var(--bb-teal-b); border-color: var(--bb-teal-b); }
  .bb-boton:focus-visible, .bb-fila:focus-visible, .bb-tag:focus-visible, .bb a:focus-visible { outline: 2px solid var(--bb-sal); outline-offset: 2px; }

  /* Distribución */
  .bb-cuerpo { display: grid; gap: 18px; grid-template-columns: minmax(0, 1fr); grid-template-areas: "escenario" "lista" "ficha" "cubierta"; }
  .bb-lista { grid-area: lista; }
  .bb-escenario { grid-area: escenario; min-width: 0; display: flex; flex-direction: column; gap: 10px; }
  .bb-cubierta { grid-area: cubierta; }
  .bb-ficha { grid-area: ficha; }
  @media (min-width: 760px) {
    .bb-cuerpo { grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); grid-template-rows: auto auto minmax(0, 1fr); grid-template-areas: "escenario escenario" "lista ficha" "cubierta ficha"; align-items: start; }
  }
  @media (min-width: 1280px) {
    .bb-cuerpo { grid-template-columns: 250px minmax(0, 1fr) 420px; grid-template-rows: auto minmax(0, 1fr); grid-template-areas: "lista escenario ficha" "lista cubierta ficha"; }
  }
  .bb--portada .bb-cuerpo { grid-template-columns: minmax(0, 1fr); grid-template-areas: "escenario"; }

  /* Lista de señales */
  .bb-lista { display: flex; flex-direction: column; gap: 12px; }
  .bb-cifra { display: flex; align-items: baseline; gap: 10px; border-bottom: 1px solid var(--bb-bosque); padding-bottom: 10px; }
