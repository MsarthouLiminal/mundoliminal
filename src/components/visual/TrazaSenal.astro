---
/**
 * TrazaSenal — banda de osciloscopio en canvas 2D.
 *
 * La traza entra como ruido y se resuelve en señal limpia cuando la sección
 * aparece en pantalla. Sirve de encabezado instrumental para "Últimos de
 * LIMINAL": lo que el canal capta, ya decodificado.
 */

interface Props {
  /** Texto de la izquierda del encabezado. */
  entrada?: string;
  /** Texto de la derecha del encabezado. */
  lectura?: string;
}

const { entrada = 'Entrada', lectura = 'Umbral 0.62' } = Astro.props;
---

<div class="traza">
  <div class="traza__cab">
    <span>{entrada} · <b class="traza__estado">Ruido</b></span>
    <span>{lectura} · Ganancia <b class="traza__gan">1.00</b></span>
  </div>
  <canvas class="traza__cv" aria-hidden="true"></canvas>
</div>

<style>
  .traza {
    border: 1px solid var(--rule);
    background: color-mix(in oklab, var(--color-vacio) 60%, transparent);
    overflow: hidden;
  }
  .traza__cab {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--muted);
  }
  .traza__cab b {
    color: var(--color-teal-brillante);
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }
  .traza__cv {
    display: block;
    width: 100%;
    height: clamp(64px, 9vh, 104px);
  }
</style>

<script>
  (() => {
    document.querySelectorAll<HTMLElement>('.traza').forEach((raiz) => {
      const cv = raiz.querySelector<HTMLCanvasElement>('.traza__cv');
      const estado = raiz.querySelector<HTMLElement>('.traza__estado');
      const gan = raiz.querySelector<HTMLElement>('.traza__gan');
      if (!cv) return;
      const ctx = cv.getContext('2d');
      if (!ctx) return;

      const lento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let w = 0;
      let h = 0;

      function medir() {
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        const r = cv!.getBoundingClientRect();
        w = r.width;
        h = r.height;
        cv!.width = Math.max(1, Math.floor(w * dpr));
        cv!.height = Math.max(1, Math.floor(h * dpr));
        ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      }
      medir();
      window.addEventListener('resize', medir, { passive: true });

      // La traza sólo se resuelve cuando la sección entra en pantalla.
      let visible = false;
      let tEntrada: number | null = null;
      new IntersectionObserver(
        (es) => {
          visible = es[0].isIntersecting;
          if (visible && tEntrada === null) tEntrada = performance.now();
        },
        { threshold: 0.2 },
      ).observe(raiz);

      const t0 = performance.now();

      function pintar(now: number) {
        requestAnimationFrame(pintar);
        if (!visible || w === 0) return;

        const t = (now - t0) / 1000;
        // 0 = ruido puro, 1 = señal limpia. Resuelve en 3 s desde que entra.
        const desde = tEntrada === null ? 0 : (now - tEntrada) / 1000;
        const r = lento ? 1 : Math.min(1, Math.max(0, (desde - 0.4) / 3));
        const e = r * r * (3 - 2 * r);

        ctx!.clearRect(0, 0, w, h);

        // Grilla
        ctx!.strokeStyle = 'rgba(222,216,206,.06)';
        ctx!.lineWidth = 1;
        const paso = Math.max(28, w / 24);
        for (let gx = 0; gx < w; gx += paso) {
          ctx!.beginPath();
          ctx!.moveTo(gx + 0.5, 0);
          ctx!.lineTo(gx + 0.5, h);
          ctx!.stroke();
        }
        ctx!.beginPath();
        ctx!.moveTo(0, h / 2 + 0.5);
        ctx!.lineTo(w, h / 2 + 0.5);
        ctx!.stroke();

        // Traza
        const pasos = Math.max(140, Math.floor(w / 2));
        ctx!.beginPath();
        for (let i = 0; i <= pasos; i++) {
          const x = i / pasos;
          const ruido =
            Math.sin(x * 97.3 + t * 7.1) * 0.5 +
            Math.sin(x * 211.7 - t * 4.3) * 0.35 +
            Math.sin(x * 43.1 + t * 11.7) * 0.3;
          const senal = Math.sin(x * Math.PI * 4 - t * 1.5) * 0.62 + Math.sin(x * Math.PI * 8 - t * 2.1) * 0.16;
          const y = ruido * (1 - e) * 0.85 + senal * e;
          const py = h / 2 - y * (h * 0.36);
          if (i === 0) ctx!.moveTo(0, py);
          else ctx!.lineTo(x * w, py);
        }
        const grad = ctx!.createLinearGradient(0, 0, w, 0);
        grad.addColorStop(0, 'rgba(11,139,110,.45)');
        grad.addColorStop(0.5, '#0FBA94');
        grad.addColorStop(1, 'rgba(11,139,110,.45)');
        ctx!.strokeStyle = grad;
        ctx!.lineWidth = 1.6;
        ctx!.lineJoin = 'round';
        ctx!.shadowColor = 'rgba(15,186,148,.6)';
        ctx!.shadowBlur = 10 + 8 * e;
        ctx!.stroke();
        ctx!.shadowBlur = 0;

        // Marcador de umbral
        ctx!.strokeStyle = `rgba(255,76,8,${0.28 + 0.32 * e})`;
        ctx!.setLineDash([4, 5]);
        ctx!.beginPath();
        ctx!.moveTo(0, h * 0.18);
        ctx!.lineTo(w, h * 0.18);
        ctx!.stroke();
        ctx!.setLineDash([]);

        if (estado) estado.textContent = e > 0.92 ? 'Señal' : e > 0.35 ? 'Resolviendo' : 'Ruido';
        if (gan) gan.textContent = (1 + e * 0.62).toFixed(2);
      }
      requestAnimationFrame(pintar);
    });
  })();
</script>
