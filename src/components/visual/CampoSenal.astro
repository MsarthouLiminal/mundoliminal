---
/**
 * CampoSenal — campo WebGL de ruido que se resuelve en señal.
 *
 * Un shader de fragmento escrito a mano (sin librerías): debajo del umbral hay
 * ruido fractal, encima hay bandas ordenadas. La línea del umbral sube a medida
 * que la sección entra en pantalla. Es el argumento del Manifiesto hecho imagen:
 * el ruido tapa la consecuencia.
 *
 * Si el navegador no da WebGL, queda el degradado de fondo y no se rompe nada.
 */

interface Props {
  /** Opacidad del conjunto. */
  opacidad?: number;
}

const { opacidad = 0.55 } = Astro.props;
---

<canvas class="campo" style={`--campo-op:${opacidad}`} aria-hidden="true"></canvas>

<style>
  .campo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    z-index: 0;
    pointer-events: none;
    opacity: var(--campo-op, 0.55);
    background: radial-gradient(120% 80% at 50% 40%, var(--color-selva) 0%, var(--color-vacio) 72%);
  }
</style>

<script>
  (() => {
    const cv = document.querySelector<HTMLCanvasElement>('.campo');
    if (!cv) return;

    const lento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const gl = cv.getContext('webgl', { antialias: false, alpha: true, powerPreference: 'low-power' });
    if (!gl) return; // queda el degradado CSS

    const VS = 'attribute vec2 p;void main(){gl_Position=vec4(p,0.0,1.0);}';
    const FS = `
precision highp float;
uniform vec2 u_res; uniform float u_t; uniform float u_s;
float hash(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453123);}
float noise(vec2 p){vec2 i=floor(p),f=fract(p);vec2 u=f*f*(3.0-2.0*f);
 return mix(mix(hash(i),hash(i+vec2(1.0,0.0)),u.x),mix(hash(i+vec2(0.0,1.0)),hash(i+vec2(1.0,1.0)),u.x),u.y);}
float fbm(vec2 p){float v=0.0,a=0.5;for(int i=0;i<5;i++){v+=a*noise(p);p*=2.03;a*=0.5;}return v;}
void main(){
 vec2 p=(gl_FragCoord.xy-0.5*u_res)/u_res.y;
 float t=u_t*0.05;
 float horiz=0.22-u_s*0.52;
 float d=p.y-horiz;
 float n=fbm(p*3.1+vec2(t*1.5,-t*0.8));
 float n2=fbm(p*7.5-vec2(t*1.1,t*0.5));
 float orden=smoothstep(-0.03,0.34,d);
 float caos=1.0-orden;
 float b=sin(p.y*54.0+n*1.8-u_t*0.55);
 b=smoothstep(0.62,1.0,b);
 vec3 vacio=vec3(0.024,0.047,0.031);
 vec3 selva=vec3(0.043,0.141,0.098);
 vec3 bosque=vec3(0.102,0.239,0.169);
 vec3 teal=vec3(0.043,0.545,0.431);
 vec3 tealb=vec3(0.059,0.729,0.580);
 vec3 c=vacio;
 c=mix(c,selva,caos*(0.24+0.58*n));
 c+=bosque*caos*pow(n2,3.0)*0.78;
 c+=teal*orden*b*0.17;
 c+=tealb*orden*pow(n2,6.0)*0.36;
 float glow=exp(-abs(d)*30.0);
 c+=tealb*glow*0.44;
 float vig=smoothstep(1.35,0.20,length(p*vec2(0.72,1.0)));
 c*=0.22+0.70*vig;
 gl_FragColor=vec4(c,1.0);
}`;

    const compilar = (tipo: number, src: string) => {
      const s = gl.createShader(tipo)!;
      gl.shaderSource(s, src);
      gl.compileShader(s);
      return gl.getShaderParameter(s, gl.COMPILE_STATUS) ? s : null;
    };
    const vs = compilar(gl.VERTEX_SHADER, VS);
    const fs = compilar(gl.FRAGMENT_SHADER, FS);
    if (!vs || !fs) return;

    const pr = gl.createProgram()!;
    gl.attachShader(pr, vs);
    gl.attachShader(pr, fs);
    gl.linkProgram(pr);
    if (!gl.getProgramParameter(pr, gl.LINK_STATUS)) return;
    gl.useProgram(pr);

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(pr, 'p');
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

    const uRes = gl.getUniformLocation(pr, 'u_res');
    const uT = gl.getUniformLocation(pr, 'u_t');
    const uS = gl.getUniformLocation(pr, 'u_s');

    function medir() {
      const dpr = Math.min(window.devicePixelRatio || 1, 1.6);
      const r = cv!.getBoundingClientRect();
      cv!.width = Math.max(1, Math.floor(r.width * dpr));
      cv!.height = Math.max(1, Math.floor(r.height * dpr));
      gl!.viewport(0, 0, cv!.width, cv!.height);
    }
    medir();
    window.addEventListener('resize', medir, { passive: true });

    let visible = false;
    new IntersectionObserver(
      (es) => {
        visible = es[0].isIntersecting;
      },
      { rootMargin: '150px' },
    ).observe(cv);

    // Progreso de la sección: 0 al entrar por abajo, 1 al salir por arriba.
    let s = 0;
    let sObjetivo = 0;
    function avance() {
      const r = cv!.getBoundingClientRect();
      sObjetivo = Math.min(1, Math.max(0, (window.innerHeight - r.top) / (window.innerHeight + r.height)));
    }
    window.addEventListener('scroll', avance, { passive: true });
    avance();

    const t0 = performance.now();
    function pintar(now: number) {
      requestAnimationFrame(pintar);
      if (!visible) return;
      s += (sObjetivo - s) * 0.07;
      gl!.uniform2f(uRes, cv!.width, cv!.height);
      gl!.uniform1f(uT, lento ? 0 : (now - t0) / 1000);
      gl!.uniform1f(uS, s);
      gl!.drawArrays(gl!.TRIANGLES, 0, 3);
    }
    requestAnimationFrame(pintar);
  })();
</script>
