---
const lines = [
  {
    title: 'LIMINAL Talks',
    body: 'Presentaciones analíticas y conversaciones a medida para empresas, asociaciones y organizaciones. Geopolítica, tecnología, economía, cultura: el tema lo definen ustedes; el método, LIMINAL.',
    href: '/talks',
  },
  {
    title: 'Reportes y briefings sectoriales',
    body: 'Análisis cerrados para entornos de alta incertidumbre. Documentos para tomar decisiones, no para enmarcar.',
    href: '/reportes',
  },
  {
    title: 'Consultoría en comunicación estratégica',
    body: 'Treinta años de comunicación profesional aplicados a posicionamiento institucional, gestión de crisis y relaciones con gobierno.',
    href: '/consultoria',
  },
];
---

<section class="commercial" aria-labelledby="commercial-heading">
  <div class="commercial__cab">
    <p class="commercial__kick">Para empresas e instituciones</p>
    <h2 id="commercial-heading" class="commercial__heading">¿Qué más hace LIMINAL?</h2>
    <p class="commercial__intro">
      El proyecto editorial es la columna. Pero LIMINAL también opera fuera del canal: tres líneas de trabajo para
      empresas, organizaciones e instituciones que necesitan leer el presente con la misma vara.
    </p>
  </div>
  <ul class="commercial__grid">
    {lines.map((line, i) => (
      <li class="line">
        <span class="line__ref">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="line__title">{line.title}</h3>
        <p class="line__body">{line.body}</p>
        <a class="line__cta" href={line.href}>
          Ver más <b aria-hidden="true">→</b>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .commercial {
    margin-top: var(--space-24);
    display: grid;
    gap: var(--space-8);
    font-family: var(--font-text-v2);
  }
  .commercial__cab {
    display: grid;
    gap: var(--space-3);
  }
  .commercial__kick {
    margin: 0;
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-lila);
  }
  .commercial__heading {
    margin: 0;
    font-family: var(--font-display-v2);
    font-weight: 800;
    font-size: clamp(1.8rem, 3.4vw, 2.4rem);
    line-height: 1;
    letter-spacing: -0.005em;
    text-transform: none;
    color: var(--color-blanco);
  }
  .commercial__intro {
    margin: 0;
    max-width: 62ch;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-hueso);
  }
  /* Registro sobrio: acá el interlocutor es institucional.
     Líneas de 1px, sin cajas; una barra Horizonte al pasar. */
  .commercial__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 3px solid var(--color-horizonte);
  }
  .line {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
    padding: var(--space-6) var(--space-6) var(--space-8);
    border-bottom: 1px solid var(--color-teal);
  }
  .line + .line {
    border-left: 1px solid var(--color-teal);
  }
  .line::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: -1px;
    height: 2px;
    background: var(--color-horizonte);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 550ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .line:hover::after,
  .line:focus-within::after {
    transform: scaleX(1);
  }
  .line__ref {
    font-family: var(--font-display-v2);
    font-weight: 800;
    font-size: 2.2rem;
    line-height: 1;
    color: var(--color-horizonte);
  }
  .line__title {
    margin: 0;
    letter-spacing: -0.005em;
    font-family: var(--font-display-v2);
    font-weight: 800;
    font-size: 1.6rem;
    line-height: 1.02;
    text-transform: none;
    color: var(--color-blanco);
    text-wrap: balance;
  }
  .line__body {
    margin: 0;
    flex-grow: 1;
    font-size: 0.94rem;
    line-height: 1.6;
    color: var(--color-hueso);
  }
  .line__cta {
    align-self: flex-start;
    margin-top: var(--space-2);
    padding-bottom: 3px;
    border-bottom: 1px solid var(--color-teal);
    font-weight: 700;
    font-size: 0.86rem;
    text-decoration: none;
    color: var(--color-blanco);
  }
  .line__cta b {
    color: var(--color-horizonte);
  }
  .line__cta:hover {
    border-color: var(--color-horizonte);
  }

  @media (max-width: 760px) {
    .commercial__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .line {
      padding: var(--space-6) 0;
    }
    .line + .line {
      border-left: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .line::after {
      transition: none;
    }
  }
</style>
