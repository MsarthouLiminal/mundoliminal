---
import type { LatestItem, Platform } from '../../lib/feeds';
import { formatPubDate } from '../../lib/feeds';

interface Props {
  item: LatestItem | null;
  platform: Platform;
  fallbackHref: string;
}

const { item, platform, fallbackHref } = Astro.props;

const platformLabel: Record<Platform, string> = {
  youtube: 'Video en YouTube',
  substack: 'Columna en Substack',
  spotify: 'Podcast en Spotify',
};

const href = item?.url ?? fallbackHref;
const title = item?.title ?? 'Próximo episodio';
const dateLabel = item ? formatPubDate(item.pubDate) : null;
const thumb = item?.thumbnail ?? null;
const isFallback = item === null;
---

<a
  class="card"
  href={href}
  target="_blank"
  rel="noopener"
  aria-label={`${platformLabel[platform]}: ${title}`}
>
  <div class="card__thumb" aria-hidden="true">
    {thumb ? (
      <img src={thumb} alt="" loading="lazy" />
    ) : (
      <span class="card__thumb-mark">LIMINAL</span>
    )}
  </div>
  <span class="card__platform">{platformLabel[platform]}</span>
  <h3 class="card__title">{title}</h3>
  {dateLabel && <span class="card__date">{dateLabel}</span>}
  {isFallback && <span class="card__date card__date--soft">Próximamente</span>}
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    text-decoration: none;
    color: inherit;
    font-family: var(--font-text-v2);
  }
  .card:hover .card__thumb {
    border-color: var(--color-horizonte);
  }
  .card:hover .card__title {
    color: var(--color-horizonte);
  }
  .card:focus-visible {
    outline: 2px solid var(--color-horizonte);
    outline-offset: 4px;
  }
  .card__thumb {
    aspect-ratio: 16 / 9;
    background: var(--color-selva);
    border: 1px solid var(--color-teal);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color 150ms;
  }
  .card__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .card__thumb-mark {
    font-family: var(--font-display-v2);
    font-weight: 800;
    font-size: 1.6rem;
    letter-spacing: 0.12em;
    color: color-mix(in oklab, var(--color-hueso) 30%, transparent);
  }
  .card__platform {
    font-weight: 700;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-horizonte);
  }
  .card__title {
    margin: 0;
    letter-spacing: -0.005em;
    font-family: var(--font-display-v2);
    font-weight: 700;
    font-size: 1.45rem;
    line-height: 1.05;
    text-transform: none;
    color: var(--color-blanco);
    text-wrap: balance;
    transition: color 150ms;
  }
  .card__date {
    font-weight: 500;
    font-size: 0.78rem;
    color: var(--color-lila);
  }
  .card__date--soft {
    font-style: normal;
  }
</style>
