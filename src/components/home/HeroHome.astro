---
/**
 * Apertura de la home: la marca, la frase, quién está detrás y, enseguida,
 * el monitor Señales de la semana (llega por el slot).
 * Ocupa más o menos media pantalla: el monitor asoma abajo sin scrollear.
 */
---

<section class="apertura" aria-labelledby="home-titulo">
  <h1 id="home-titulo" class="apertura__marca">
    <img src="/brand/logos/liminal-logo-v2-1.svg" alt="LIMINAL" width="960" height="288" fetchpriority="high" />
  </h1>

  <p class="apertura__lema">Leer el presente como un sistema.</p>

  <p class="apertura__texto">
    Un proyecto editorial sobre geopolítica, tecnología y economía. Separa el ruido y la propaganda de lo que
    cambia algo: qué pasa, cómo funciona y qué consecuencias tiene.
  </p>

  <figure class="apertura__retrato">
    <img
      src="/images/martin-sarthou-retrato.jpg"
      srcset="/images/martin-sarthou-retrato-360.jpg 360w, /images/martin-sarthou-retrato.jpg 720w"
      sizes="(max-width: 860px) 96px, 300px"
      width="720"
      height="900"
      alt="Martín Sarthou"
    />
  </figure>

  <div class="apertura__firma">
    <p class="apertura__nombre">Martín Sarthou</p>
    <p class="apertura__roles">Periodista, speaker, docente</p>
    <p class="apertura__enlaces">
      <a href="/sobre-martin">Quién es <b aria-hidden="true">→</b></a>
      <a href="/talks">LIMINAL Talks <b aria-hidden="true">→</b></a>
    </p>
  </div>
</section>

{/* El monitor Señales de la semana. */}
<slot />

<style>
  .apertura {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    grid-template-areas:
      'marca retrato'
      'lema retrato'
      'texto retrato'
      'firma retrato';
    grid-template-rows: auto auto auto 1fr;
    column-gap: var(--space-16);
    row-gap: var(--space-4);
    padding: var(--space-4) 0 var(--space-10, 2.5rem);
    border-bottom: 1px solid var(--color-teal);
    font-family: var(--font-text-v2);
  }

  .apertura__marca {
    grid-area: marca;
    margin: 0 0 0 calc(-0.047 * min(560px, 100%));
    line-height: 0;
  }
  .apertura__marca img {
    display: block;
    width: min(560px, 100%);
    height: auto;
  }

  .apertura__lema {
    grid-area: lema;
    margin: 0;
    font-family: var(--font-display-v2);
    font-weight: 800;
    font-size: clamp(1.9rem, 3.6vw, 2.8rem);
    line-height: 1;
    letter-spacing: -0.005em;
    color: var(--color-sal);
    text-wrap: balance;
  }

  .apertura__texto {
    grid-area: texto;
    margin: 0;
    max-width: 54ch;
    font-size: 1.02rem;
    line-height: 1.6;
    color: var(--color-hueso);
  }

  /* El retrato lleva los corchetes Teal del logo: misma familia visual. */
  .apertura__retrato {
    grid-area: retrato;
    position: relative;
    align-self: center;
    margin: 0;
    padding: 10px;
  }
  .apertura__retrato::before,
  .apertura__retrato::after {
    content: '';
    position: absolute;
    width: 28px;
    height: 28px;
    border-color: var(--color-teal);
    border-style: solid;
  }
  .apertura__retrato::before {
    top: 0;
    left: 0;
    border-width: 3px 0 0 3px;
  }
  .apertura__retrato::after {
    right: 0;
    bottom: 0;
    border-width: 0 3px 3px 0;
  }
  .apertura__retrato img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .apertura__firma {
    grid-area: firma;
    align-self: end;
    display: grid;
    gap: var(--space-1);
    padding-top: var(--space-4);
    border-top: 3px solid var(--color-horizonte);
    max-width: 54ch;
  }
  .apertura__nombre {
    margin: 0;
    font-family: var(--font-display-v2);
    font-weight: 800;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--color-blanco);
  }
  .apertura__roles {
    margin: 0;
    font-weight: 500;
    font-size: 0.92rem;
    color: var(--color-lila);
  }
  .apertura__enlaces {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    margin: var(--space-2) 0 0;
  }
  .apertura__enlaces a {
    display: inline-flex;
    gap: 8px;
    font-weight: 700;
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-horizonte);
  }
  .apertura__enlaces a:hover {
    color: var(--color-blanco);
  }

  /* Celular y tablet: el retrato pasa a miniatura al lado de la firma. */
  @media (max-width: 860px) {
    .apertura {
      grid-template-columns: 96px minmax(0, 1fr);
      grid-template-areas:
        'marca marca'
        'lema lema'
        'texto texto'
        'retrato firma';
      grid-template-rows: none;
      column-gap: var(--space-4);
      padding: var(--space-6) 0 var(--space-8);
    }
    .apertura__retrato {
      align-self: start;
      padding: 5px;
    }
    .apertura__retrato::before,
    .apertura__retrato::after {
      width: 16px;
      height: 16px;
      border-width: 2px 0 0 2px;
    }
    .apertura__retrato::after {
      border-width: 0 2px 2px 0;
    }
    .apertura__firma {
      align-self: start;
    }
  }
</style>
