---
/**
 * Aviso del especial "Midterms desde el Sur" en la home.
 * Se muestra hasta el viernes 6 de noviembre de 2026 inclusive (hora de
 * Uruguay). El sitio se reconstruye cada 6 horas, así que se va solo.
 */
const vigente = Date.now() < Date.parse('2026-11-07T03:00:00Z');

// Bancas del Senado que cambiaron de partido (proyecciones de AP, 4/11/2026).
const giro = ['Kansas', 'Iowa', 'Ohio', 'Texas', 'Maine', 'Carolina del Norte', 'Carolina del Sur'];
---

{vigente && (
  <section class="especial ventana" aria-labelledby="especial-midterms">
    <div class="especial__texto">
      <p class="especial__kick">Especial · Legislativas de EE.UU. · Resultados</p>
      <h2 id="especial-midterms" class="especial__titulo">Midterms desde el Sur: los resultados</h2>
      <p class="especial__bajada">
        Los demócratas ganaron el Congreso y el Senado se dio vuelta en tierra de soja y carne. Carrera por
        carrera y lo que cambia para seis países del Sur.
      </p>
      <a class="especial__boton" href="/midterms/">Ver los resultados <b aria-hidden="true">→</b></a>
    </div>
    <div class="especial__giro" aria-label="Bancas del Senado que cambiaron de partido">
      <p class="especial__giro-kick">Pasaron a los demócratas</p>
      <ul>
        {giro.map((e) => (
          <li>{e}</li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .especial {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    margin-top: var(--space-8);
    padding: var(--space-8);
    background: var(--color-selva);
    border-top: 3px solid var(--color-horizonte);
    font-family: var(--font-text-v2);
  }
  .especial__texto {
    flex: 1 1 420px;
    min-width: 0;
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }
  .especial__kick {
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--tinta-meta);
  }
  .especial__titulo {
    margin: 0;
    font-family: var(--font-display-v2);
    font-weight: 800;
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
    line-height: 0.95;
    color: var(--tinta-fuerte);
  }
  .especial__bajada {
    max-width: 56ch;
    line-height: 1.55;
    color: var(--tinta);
  }
  .especial__boton {
    margin-top: var(--space-2);
    display: inline-block;
    padding: 0.7rem 1.2rem;
    background: var(--boton);
    color: var(--sobre-boton);
    font-weight: 700;
    text-decoration: none;
    border-radius: 2px;
  }
  .especial__boton b {
    color: var(--color-oxido);
  }
  .especial__boton:hover {
    background: var(--boton-hover);
  }
  .especial__giro {
    flex: 0 1 300px;
    max-width: 100%;
  }
  .especial__giro-kick {
    margin: 0 0 var(--space-3);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--tinta-meta);
  }
  .especial__giro ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .especial__giro li {
    padding: 6px 12px;
    border-left: 4px solid #3f86e0;
    background: rgba(255, 255, 255, 0.06);
    font-family: var(--font-display-v2);
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--tinta-fuerte);
  }
</style>
