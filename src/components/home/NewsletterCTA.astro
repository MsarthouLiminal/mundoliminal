---
type Variant = 'hero' | 'standalone';

interface Props {
  variant?: Variant;
}

const { variant = 'hero' } = Astro.props;
const hasHeading = Astro.slots.has('heading');
---

<section class:list={['cta', `cta--${variant}`]}>
  {hasHeading && (
    <h2 class="cta__heading"><slot name="heading" /></h2>
  )}
  <p class="cta__lead">Suscribite al newsletter de LIMINAL.</p>
  <p class="cta__sub">El umbral entre lo que sucede y lo que merece ser analizado.</p>
  <p class="cta__body">
    Tres veces por semana, un análisis sobre geopolítica, tecnología y economía.
    Donde lo impactante no está por encima de lo importante.
    Sin urgencia falsa, sin agenda, sin relleno.
  </p>
  <p class="cta__pull"><em>Lo que pasa, cómo funciona, qué cambia.</em></p>
  <a class="cta__button" href="https://mundoliminal.substack.com" target="_blank" rel="noopener">
    Suscribirme →
  </a>
</section>

<style>
  .cta {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: var(--content-max);
    text-align: left;
    font-family: var(--font-text-v2);
  }
  .cta--hero {
    margin-top: var(--space-12);
    align-self: flex-start;
  }
  .cta--standalone {
    background: var(--fondo-caja);
    border-top: 1px solid var(--color-teal);
    padding: var(--space-8);
    margin-top: var(--space-12);
  }
  .cta__heading {
    font-size: clamp(1.75rem, 3.2vw, 2.25rem);
    line-height: 0.95;
    color: var(--tinta-fuerte);
    margin-bottom: var(--space-2);
  }
  .cta__lead {
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--tinta-fuerte);
  }
  .cta__sub {
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--tinta-meta);
  }
  .cta__body {
    font-size: 1rem;
    color: var(--tinta);
    line-height: 1.6;
  }
  .cta__pull {
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--tinta-fuerte);
  }
  .cta__pull em {
    font-style: normal;
  }
  .cta__button {
    align-self: flex-start;
    margin-top: var(--space-4);
    display: inline-block;
    padding: 13px 22px;
    border-radius: 4px;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    color: var(--sobre-boton);
    background: var(--boton);
    transition: background 150ms;
  }
  .cta__button:hover {
    background: var(--boton-hover);
    color: var(--sobre-boton);
  }
  .cta__button:focus-visible {
    outline: 2px solid var(--senal);
    outline-offset: 3px;
  }

  @media (max-width: 640px) {
    .cta--standalone {
      padding: var(--space-6) var(--space-4);
    }
  }
</style>
