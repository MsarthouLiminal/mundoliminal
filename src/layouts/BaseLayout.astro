---
import '../styles/global.css';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  /** Páginas en construcción: que Google no las indexe todavía. */
  noindex?: boolean;
}

const {
  title,
  description = 'LIMINAL · Señales que importan.',
  noindex = false,
} = Astro.props;

const fullTitle = title === 'LIMINAL' ? 'LIMINAL · Señales que importan.' : `${title} · LIMINAL`;

// URL canónica: siempre mundoliminal.com (sin www) y con barra final,
// que es la forma en que Cloudflare Pages sirve cada página. Así Google
// deja de tratar www/sin www y con/sin barra como páginas duplicadas.
const ruta = Astro.url.pathname === '/' || Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonical = new URL(ruta, Astro.site ?? 'https://mundoliminal.com').href;
---

<!doctype html>
<html lang="es-UY">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="LIMINAL" />
    <meta name="theme-color" content="#060C08" />
  </head>
  <body>
    <SiteHeader />
    <main>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  main {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: var(--space-12) var(--space-8);
  }

  @media (max-width: 720px) {
    main {
      padding: var(--space-8) var(--space-4);
    }
  }
</style>
