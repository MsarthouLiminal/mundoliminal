---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  getYouTubeLatestList,
  getSubstackLatestList,
  getSpotifyLatestList,
  formatPubDate,
  type LatestItem,
  type Platform,
} from '../../lib/feeds';

const settled = await Promise.allSettled([
  getYouTubeLatestList(5),
  getSubstackLatestList(5),
  getSpotifyLatestList(5),
]);

const [ytList, sbList, spList] = settled.map((r): LatestItem[] =>
  r.status === 'fulfilled' ? r.value : [],
);

interface BlockConfig {
  platform: Platform;
  label: string;
  items: LatestItem[];
  archiveHref: string;
  archiveLabel: string;
  emptyLabel: string;
}

const blocks: BlockConfig[] = [
  {
    platform: 'youtube',
    label: 'En YouTube',
    items: ytList,
    archiveHref: 'https://www.youtube.com/@trimaxmediaok',
    archiveLabel: 'Ver todos los videos',
    emptyLabel: 'Próximo video en camino.',
  },
  {
    platform: 'substack',
    label: 'En Substack',
    items: sbList,
    archiveHref: 'https://mundoliminal.substack.com',
    archiveLabel: 'Ver todas las columnas',
    emptyLabel: 'Próxima columna en camino.',
  },
  {
    platform: 'spotify',
    label: 'En Spotify',
    items: spList,
    archiveHref: 'https://open.spotify.com/show/5iy7NKRkKbcOZxLzld1nNX',
    archiveLabel: 'Ver todos los episodios',
    emptyLabel: 'Próximo episodio en camino.',
  },
];
---

<BaseLayout
  title="Catálogo"
  description="Lo más reciente de LIMINAL en sus tres formatos: video en YouTube, columna en Substack y podcast en Spotify."
>
  <div class="catalogo">

    <!-- TÍTULO DE PÁGINA -->
    <header class="page-header">
      <h1>Catálogo.</h1>
    </header>

    <!-- APERTURA EDITORIAL -->
    <section class="apertura">
      <p>
        Tres lenguajes, una sola idea editorial. LIMINAL produce análisis
        en tres formatos: video, columna escrita y conversación. Cada uno
        aporta algo distinto, y cada uno vive en la plataforma donde
        funciona mejor: YouTube para el video, Substack para el texto largo,
        Spotify para el podcast.
      </p>
      <p class="apertura-cierre">
        Acá encontrás lo más reciente de los tres. El archivo completo de
        cada formato vive en su plataforma.
      </p>
    </section>

    <hr class="divisor" />

    <!-- BLOQUES POR PLATAFORMA -->
    {blocks.map((block) => (
      <section class="bloque" aria-labelledby={`bloque-${block.platform}`}>
        <h2 id={`bloque-${block.platform}`} class="bloque-titulo">
          {block.label}
        </h2>

        {block.items.length === 0 ? (
          <p class="bloque-vacio">{block.emptyLabel}</p>
        ) : (
          <ul class="lista">
            {block.items.map((item) => (
              <li class="item">
                <a
                  class="item-link"
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <h3 class="item-titulo">{item.title}</h3>
                  <span class="item-fecha">{formatPubDate(item.pubDate)}</span>
                </a>
              </li>
            ))}
          </ul>
        )}

        <a
          class="archivo-link"
          href={block.archiveHref}
          target="_blank"
          rel="noopener noreferrer"
        >
          {block.archiveLabel} <b aria-hidden="true">→</b>
        </a>
      </section>
    ))}

  </div>
</BaseLayout>

<style>
  /* Brand Kit v2.1: titulares en Big Shoulders Display 800 (caja mixta),
     todo lo que se lee en Chivo. */
  .catalogo {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--space-16) var(--space-6) var(--space-24);
    color: var(--fg-default);
    font-family: var(--font-text-v2);
    font-weight: 400;
    line-height: 1.65;
    font-size: 1.05rem;
  }

  /* HEADER DE PÁGINA */
  .page-header {
    margin-bottom: var(--space-12);
  }

  .page-header h1 {
    font-size: clamp(3rem, 8vw, 5.5rem);
    color: var(--tinta-fuerte);
    margin: 0;
    line-height: 0.92;
  }

  /* APERTURA */
  .apertura p {
    margin: 0 0 var(--space-6);
  }

  .apertura-cierre {
    color: var(--tinta-fuerte);
    font-weight: 700;
    margin-top: var(--space-8);
  }

  /* DIVISOR ENTRE BLOQUES PRINCIPALES */
  .divisor {
    border: none;
    border-top: 1px solid var(--color-teal);
    margin: var(--space-16) 0;
  }

  /* BLOQUES */
  .bloque {
    margin-bottom: var(--space-16);
  }

  .bloque:last-of-type {
    margin-bottom: 0;
  }

  .bloque-titulo {
    font-size: 2rem;
    line-height: 1;
    color: var(--tinta-fuerte);
    margin: 0 0 var(--space-6);
  }

  .bloque-vacio {
    color: var(--tinta-suave);
    margin: 0 0 var(--space-6);
  }

  /* LISTA DE PIEZAS */
  .lista {
    list-style: none;
    margin: 0 0 var(--space-6);
    padding: 0;
  }

  .item {
    border-top: 1px solid var(--color-teal);
  }

  .item:last-of-type {
    border-bottom: 1px solid var(--color-teal);
  }

  .item-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4) 0;
    text-decoration: none;
    color: inherit;
  }

  .item-link:hover .item-titulo,
  .item-link:focus-visible .item-titulo {
    color: var(--senal);
  }
  .item-link:focus-visible {
    outline: 2px solid var(--senal);
    outline-offset: 3px;
  }

  .item-titulo {
    font-size: 1.55rem;
    color: var(--tinta-fuerte);
    margin: 0;
    line-height: 1;
    transition: color 150ms;
  }

  .item-fecha {
    font-weight: 500;
    font-size: 0.82rem;
    color: var(--tinta-meta);
    font-variant-numeric: tabular-nums;
  }

  /* LINK AL ARCHIVO COMPLETO */
  .archivo-link {
    display: inline-block;
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--tinta-fuerte);
    text-decoration: none;
    border-bottom: 1px solid var(--color-teal);
    padding-bottom: 3px;
    margin-top: var(--space-2);
    transition: border-color 150ms;
  }
  .archivo-link b {
    color: var(--senal);
  }

  .archivo-link:hover,
  .archivo-link:focus-visible {
    color: var(--tinta-fuerte);
    border-bottom-color: var(--senal);
  }

  /* RESPONSIVE */
  @media (max-width: 600px) {
    .catalogo {
      padding: var(--space-8) 0 var(--space-16);
      font-size: 1rem;
    }

    .item-titulo {
      font-size: 1.3rem;
    }
  }
</style>
