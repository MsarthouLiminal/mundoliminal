---
/**
 * Home de mundoliminal.com: una portada.
 *
 * Arriba, la apertura. Enseguida, en el primer pantallazo, la portada en dos
 * columnas: Señales de la semana (mapa y titulares) y Lo último (columna,
 * video y podcast). En el celular, Lo último va primero. El monitor completo,
 * con hecho, lectura y fuente, vive en /senales.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroHome from '../components/home/HeroHome.astro';
import LoUltimo from '../components/home/LoUltimo.astro';
import Manifesto from '../components/home/Manifesto.astro';
import CommercialBlock from '../components/home/CommercialBlock.astro';
import SenalesPortada from '../components/senales/SenalesPortada.astro';
import { edicionVigente } from '../lib/senales';
import {
  getYouTubeLatest,
  getSubstackLatestList,
  getSpotifyLatest,
  type LatestItem,
} from '../lib/feeds';

const [yt, sbLista, sp] = await Promise.all([
  getYouTubeLatest().catch((): LatestItem | null => null),
  getSubstackLatestList(3).catch((): LatestItem[] => []),
  getSpotifyLatest().catch((): LatestItem | null => null),
]);

const edicion = edicionVigente();
---

<BaseLayout
  title="LIMINAL"
  description="Monitor semanal de minerales críticos, chokepoints, infraestructura de la IA y conflictos, con fuente y fecha. Análisis de Martín Sarthou desde Montevideo."
>
  <HeroHome />

  <div class="portada">
    <div class="portada__senales">
      <SenalesPortada edicion={edicion} />
    </div>
    <div class="portada__ultimo">
      <LoUltimo columna={sbLista[0] ?? null} columnasAnteriores={sbLista.slice(1, 3)} video={yt} podcast={sp} />
    </div>
  </div>

  {edicion.agenda.length > 0 && (
    <section class="observar" aria-labelledby="observar-h">
      <h2 id="observar-h">Qué observar</h2>
      <ol>
        {edicion.agenda.map((a) => (
          <li>
            <span class="observar__eje">{a.eje.replace(/\s*·\s*/g, ' y ')}</span>
            {a.fecha ? <time datetime={a.fecha}>{a.texto}</time> : <time>{a.texto}</time>}
            <p>{a.detalle}</p>
          </li>
        ))}
      </ol>
    </section>
  )}

  <Manifesto />

  <CommercialBlock />
</BaseLayout>

<style>
  .portada {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-12);
    margin-top: var(--space-8);
  }
  .portada__senales {
    flex: 999 1 560px;
    min-width: 0;
  }
  .portada__ultimo {
    flex: 1 1 320px;
    min-width: 0;
  }

  .observar {
    margin-top: var(--space-16);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-teal);
    display: grid;
    gap: var(--space-4);
    font-family: var(--font-text-v2);
  }
  .observar h2 {
    font-family: var(--font-display-v2);
    font-weight: 800;
    font-size: 2rem;
    line-height: 1;
    letter-spacing: 0;
    text-transform: none;
    color: var(--tinta-fuerte);
  }
  .observar ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-8);
  }
  .observar li {
    display: grid;
    align-content: start;
    gap: 6px;
  }
  .observar__eje {
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--tinta-meta);
  }
  .observar time {
    font-family: var(--font-display-v2);
    font-weight: 800;
    font-size: 2rem;
    line-height: 1;
    color: var(--tinta-fuerte);
  }
  .observar p {
    font-size: 0.95rem;
    line-height: 1.45;
    color: var(--tinta);
  }

  @media (max-width: 960px) {
    .observar ol {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .portada {
      gap: var(--space-10, 2.5rem);
      margin-top: var(--space-6);
    }
    /* En el celular, lo último va antes que Señales. */
    .portada__ultimo {
      order: -1;
      flex-basis: 100%;
    }
    .portada__senales {
      flex-basis: 100%;
    }
    .observar {
      margin-top: var(--space-12);
    }
    .observar ol {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-4);
    }
    .observar li {
      grid-template-columns: 76px minmax(0, 1fr);
      column-gap: 12px;
    }
    .observar li time {
      grid-column: 1;
      grid-row: 1 / span 2;
      font-size: 1.5rem;
    }
    .observar__eje,
    .observar p {
      grid-column: 2;
    }
  }
</style>
