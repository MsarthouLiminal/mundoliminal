---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroHome from '../components/home/HeroHome.astro';
import LatestCard from '../components/home/LatestCard.astro';
import Manifesto from '../components/home/Manifesto.astro';
import CommercialBlock from '../components/home/CommercialBlock.astro';
import MonitorSenales from '../components/senales/MonitorSenales.astro';
import { edicionVigente } from '../lib/senales';
import {
  getYouTubeLatest,
  getSubstackLatest,
  getSpotifyLatest,
  type LatestItem,
} from '../lib/feeds';

const settled = await Promise.allSettled([
  getYouTubeLatest(),
  getSubstackLatest(),
  getSpotifyLatest(),
]);
const [yt, sb, sp] = settled.map((r): LatestItem | null =>
  r.status === 'fulfilled' ? r.value : null,
);

const edicion = edicionVigente();
---

<BaseLayout title="LIMINAL">
  <HeroHome>
    <MonitorSenales edicion={edicion} />
  </HeroHome>

  <section class="ultimos" aria-labelledby="latest-heading">
    <div class="ultimos__cab">
      <h2 id="latest-heading">Lo último de LIMINAL</h2>
      <p>El análisis de la semana en video, columna y podcast.</p>
    </div>
    <ul class="ultimos__grid">
      <li>
        <LatestCard
          item={yt}
          platform="youtube"
          fallbackHref="https://www.youtube.com/@trimaxmediaok"
        />
      </li>
      <li>
        <LatestCard
          item={sb}
          platform="substack"
          fallbackHref="https://mundoliminal.substack.com"
        />
      </li>
      <li>
        <LatestCard
          item={sp}
          platform="spotify"
          fallbackHref="https://open.spotify.com/show/5iy7NKRkKbcOZxLzld1nNX"
        />
      </li>
    </ul>
  </section>

  <Manifesto />

  <CommercialBlock />
</BaseLayout>

<style>
  .ultimos {
    margin-top: var(--space-16);
    display: grid;
    gap: var(--space-8);
    font-family: var(--font-text-v2);
  }
  .ultimos__cab {
    display: grid;
    gap: var(--space-2);
    padding-bottom: var(--space-4);
    border-bottom: 3px solid var(--color-horizonte);
  }
  .ultimos__cab h2 {
    margin: 0;
    font-family: var(--font-display-v2);
    font-weight: 800;
    font-size: clamp(1.8rem, 3.4vw, 2.4rem);
    line-height: 1;
    letter-spacing: -0.005em;
    text-transform: none;
    color: var(--color-blanco);
  }
  .ultimos__cab p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-hueso);
  }
  .ultimos__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
  }

  @media (max-width: 720px) {
    .ultimos__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
