---
/**
 * Especial "Midterms desde el Sur" (legislativas de EE.UU., 3/11/2026).
 *
 * El simulador es una página autónoma (public/midterms/simulador.html) con
 * su propio CSS y sus gráficos. Va dentro de un iframe para que ninguna de
 * sus reglas toque el resto del sitio; con ?embed se muestra en modo
 * ventana (oscuro), sin su propio encabezado, y avisa su alto para que el
 * iframe crezca sin barra de desplazamiento interna.
 */
import BaseLayout from '../layouts/BaseLayout.astro';

const columna = 'https://mundoliminal.substack.com/p/midterms-2026-cono-sur';
---

<BaseLayout
  title="Midterms desde el Sur: los resultados"
  description="Los resultados de las legislativas de Estados Unidos del 3 de noviembre de 2026, leídos desde el Cono Sur: el Senado carrera por carrera y lo que cambia para seis países."
  imagen="/og/midterms-resultados.jpg"
>
  <header class="esp">
    <p class="esp__kick">Especial · Elecciones legislativas de Estados Unidos, 3 de noviembre de 2026 · Resultados</p>
    <h1 class="esp__titulo">Midterms desde el Sur: los resultados</h1>
    <p class="esp__bajada">
      Los demócratas ganaron la Cámara y el Senado, y el Senado se dio vuelta en tierra de soja y carne. Qué pasó en
      cada carrera y qué cambia para Montevideo, Buenos Aires, Asunción, Santiago, Brasilia y Bogotá. A Donald Trump
      le sacaron el Congreso, no la lapicera.
    </p>
    <p class="esp__enlaces">
      <a href={columna}>La columna: El Senado se juega en tierra de soja y carne <b aria-hidden="true">→</b></a>
    </p>
  </header>

  <section class="esp__ventana ventana" aria-label="Resultados de las elecciones legislativas">
    <iframe
      id="simulador-midterms"
      src="/midterms/simulador.html?embed"
      title="Midterms desde el Sur: los resultados"
      loading="eager"
    ></iframe>
    <p class="esp__alt">
      ¿No se ve bien? <a href="/midterms/simulador.html">Abrí la página en pantalla completa</a>.
    </p>
  </section>
</BaseLayout>

<script>
  const marco = document.getElementById('simulador-midterms') as HTMLIFrameElement | null;
  window.addEventListener('message', (e) => {
    if (!marco || e.origin !== window.location.origin) return;
    const alto = e.data && typeof e.data.liminalMidterms === 'number' ? e.data.liminalMidterms : 0;
    if (alto > 300) marco.style.height = `${alto}px`;
  });
</script>

<style>
  .esp {
    display: grid;
    gap: var(--space-3);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-teal);
    font-family: var(--font-text-v2);
  }
  .esp__kick {
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--tinta-meta);
  }
  .esp__titulo {
    margin: 0;
    font-family: var(--font-display-v2);
    font-weight: 800;
    font-size: clamp(2.8rem, 7vw, 5.2rem);
    line-height: 0.95;
    color: var(--tinta-fuerte);
    text-wrap: balance;
  }
  .esp__bajada {
    max-width: 62ch;
    font-size: 1.1rem;
    line-height: 1.55;
    color: var(--tinta);
  }
  .esp__enlaces a {
    font-weight: 700;
    color: var(--tinta-fuerte);
    text-decoration: none;
  }
  .esp__enlaces a b {
    color: var(--senal);
  }
  .esp__enlaces a:hover {
    text-decoration: underline;
    text-decoration-color: var(--senal);
  }
  /* A sangre, como el manifiesto: el simulador se lee como una ventana oscura sobre el papel. */
  .esp__ventana {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-top: var(--space-8);
    background: var(--color-selva);
    border-block: 1px solid var(--color-teal);
    padding-block: var(--space-4) var(--space-8);
  }
  .esp__ventana iframe {
    display: block;
    width: 100%;
    max-width: calc(var(--container-max) + 40px);
    margin: 0 auto;
    min-height: 100vh;
    border: 0;
    background: var(--color-selva);
  }
  .esp__alt {
    max-width: var(--container-max);
    margin: var(--space-4) auto 0;
    padding-inline: var(--space-8);
    font-size: var(--fs-sm);
    color: var(--tinta-meta);
  }
  .esp__alt a {
    color: var(--tinta-fuerte);
  }
</style>
