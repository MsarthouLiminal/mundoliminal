---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterCTA from '../components/home/NewsletterCTA.astro';

const categories = [
  {
    name: 'LIMINAL Talks',
    desc: 'presentaciones analíticas para empresas, asociaciones y organizaciones.',
  },
  {
    name: 'Reportes y briefings sectoriales',
    desc: 'análisis cerrados para entornos de alta incertidumbre.',
  },
  {
    name: 'Consultoría en comunicación estratégica',
    desc: 'posicionamiento institucional, gestión de crisis, relaciones con gobierno.',
  },
  {
    name: 'Colaboraciones editoriales',
    desc: 'sponsorships, partnerships, contenido conjunto, aliados de proyecto.',
  },
  {
    name: 'Prensa y entrevistas',
    desc: 'apariciones en medios, entrevistas, panelista en eventos.',
  },
  {
    name: 'Otros',
    desc: 'todo lo que no entre en las categorías anteriores.',
  },
];
---

<BaseLayout
  title="Contacto"
  description="Cómo escribirle a Martín Sarthou y a LIMINAL: charlas, briefings, consultoría, colaboraciones editoriales y prensa."
>
  <article class="contact">
    <header class="contact__opening">
      <h1>Contacto.</h1>
      <p>Si estás acá, probablemente tenés algo concreto para proponer.</p>
      <p>Bienvenido.</p>
    </header>

    <section class="contact__email-block" aria-labelledby="email-heading">
      <h2 id="email-heading" class="subhead">Escribime a:</h2>
      <a class="contact__email" href="mailto:contacto@mundoliminal.com">
        contacto@mundoliminal.com
      </a>
    </section>

    <section class="contact__categories" aria-labelledby="cats-heading">
      <h2 id="cats-heading" class="subhead">Para qué estás escribiendo:</h2>
      <ul class="cats">
        {categories.map((c) => (
          <li class="cat">
            <span class="cat__name">{c.name}:</span>
            <span class="cat__desc">{c.desc}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="contact__more" aria-labelledby="more-heading">
      <h2 id="more-heading" class="subhead">También acá:</h2>
      <p>
        LinkedIn →
        <a href="https://www.linkedin.com/in/martinsarthou/" target="_blank" rel="noopener">
          linkedin.com/in/martinsarthou
        </a>
      </p>
      <p class="contact__location">Montevideo, Uruguay (UTC-3).</p>
    </section>

    <NewsletterCTA variant="standalone">
      <Fragment slot="heading">
        ¿Todavía no tenés algo concreto,<br />pero te interesa el proyecto?
      </Fragment>
    </NewsletterCTA>
  </article>
</BaseLayout>

<style>
  /* Brand Kit v2.1: titulares en Big Shoulders Display 800 (caja mixta),
     todo lo que se lee en Chivo. */
  .contact {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    max-width: var(--content-max);
    font-family: var(--font-text-v2);
  }

  .contact__opening {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .contact__opening h1 {
    font-size: clamp(3rem, 7vw, 5rem);
    line-height: 0.92;
    color: var(--tinta-fuerte);
    margin-bottom: var(--space-4);
  }
  .contact__opening p {
    font-size: 1.2rem;
    color: var(--tinta);
    line-height: 1.6;
  }

  .subhead {
    font-size: 1.75rem;
    line-height: 1;
    color: var(--tinta-fuerte);
    margin-bottom: var(--space-4);
  }

  .contact__email-block {
    padding: var(--space-4) 0;
  }
  .contact__email {
    display: inline-block;
    font-weight: 700;
    font-size: clamp(1.3rem, 3.5vw, 2rem);
    color: var(--tinta-fuerte);
    text-decoration: underline;
    text-decoration-color: var(--color-teal);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
    transition: color 150ms, text-decoration-color 150ms;
    overflow-wrap: anywhere;
  }
  .contact__email:hover {
    color: var(--tinta-fuerte);
    text-decoration-color: var(--senal);
  }

  .cats {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-teal);
  }
  .cat {
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-teal);
    font-size: 1rem;
    line-height: 1.55;
    color: var(--tinta);
  }
  .cat__name {
    font-weight: 700;
    color: var(--tinta-fuerte);
  }

  .contact__more {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .contact__more p {
    font-size: 1rem;
    color: var(--tinta);
  }
  .contact__more a {
    font-weight: 700;
    color: var(--tinta-fuerte);
    text-decoration: underline;
    text-decoration-color: var(--color-teal);
    text-underline-offset: 4px;
  }
  .contact__more a:hover {
    text-decoration-color: var(--senal);
  }
  .contact__location {
    font-weight: 500;
    color: var(--tinta-meta) !important;
  }

  @media (max-width: 640px) {
    .contact__opening p {
      font-size: 1.08rem;
    }
    .subhead {
      font-size: 1.5rem;
    }
  }
</style>
